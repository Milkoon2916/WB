+<!DOCTYPE html>
+<html lang="ko">
+<head>
+<meta charset="UTF-8">
+<style>
+  @page { size: A4; margin: 16mm 14mm 18mm 14mm; }
+  * { box-sizing: border-box; }
+  body {
+    font-family: "Noto Serif KR", "Noto Sans CJK KR", serif;
+    color: #232019;
+    font-size: 10.5pt;
+    line-height: 1.6;
+    position: relative;
+  }
+  {% if watermark %}
+  .watermark {
+    position: fixed;
+    top: 0; left: 0; right: 0; bottom: 0;
+    background-image: url("{{ watermark }}");
+    background-repeat: repeat;
+    background-position: top left;
+    background-size: 90mm 90mm;
+    opacity: 0.12;
+    z-index: -1;
+  }
+  {% endif %}
+  .stamp-badge {
+    display:inline-block; border:1.5px solid #2F5233; color:#2F5233;
+    font-family:"Courier New",monospace; font-size:8pt; letter-spacing:.08em;
+    padding:2px 8px; border-radius:14px; margin-bottom:10px;
+  }
+  h1 { font-size:17pt; font-weight:400; margin:0 0 2px; }
+  .sub { font-size:9.5pt; color:#726C60; margin:0 0 14px; }
+  .instr { font-size:9.5pt; font-weight:700; margin:16px 0 8px; }
+  .passage-box {
+    background:#FBF8F1; border:1px solid #DDD6C4; border-radius:3px;
+    padding:10mm 11mm; font-size:10pt; line-height:1.75; margin-bottom:2mm;
+  }
+  .item {
+    display:table; width:100%; padding:5px 0;
+    border-bottom:1px dashed #DDD6C4; font-size:10pt; line-height:1.55;
+  }
+  .item:last-child { border-bottom:none; }
+  .num-cell { display:table-cell; width:7mm; vertical-align:top; color:#2F5233; font-weight:700; font-family:"Courier New",monospace; }
+  .text-cell { display:table-cell; vertical-align:top; padding-right:4mm; }
+  .item.en .text-cell { font-style:italic; }
+  .ox-cell { display:table-cell; width:16mm; vertical-align:top; text-align:right; font-family:"Courier New",monospace; font-size:9pt; color:#aaa; }
+
+  .key-page { page-break-before: always; }
+  .key-title { font-size:15pt; font-weight:400; margin:0 0 3px; }
+  .key-sub { font-size:9pt; color:#726C60; font-family:"Courier New",monospace; margin:0 0 14px; }
+  .key-grid {
+    display:flex; flex-wrap:wrap; gap:8px 4px;
+    font-family:"Courier New",monospace; font-size:9.5pt;
+  }
+  .key-grid span { display:inline-block; width:16mm; }
+  .key-grid b { color:#2F5233; margin-right:3px; }
+</style>
+</head>
+<body>
+{% if watermark %}<div class="watermark"></div>{% endif %}
+
+{% if source %}<span class="stamp-badge">{{ source }}</span>{% endif %}
+<h1>{{ title_ko }}</h1>
+<p class="sub">{{ title_en }}</p>
+
+<div class="instr">다음 글을 읽고 물음에 답하시오.</div>
+<div class="passage-box">{{ passage }}</div>
+
+<div class="instr">{{ ko_range }}&nbsp;&nbsp;글의 내용과 일치하면 O, 일치하지 않으면 X를 고르시오.</div>
+{% for it in group_a %}
+<div class="item">
+  <span class="num-cell">{{ it.num }}</span>
+  <span class="text-cell">{{ it.text }}</span>
+  <span class="ox-cell">O&nbsp;&nbsp;X</span>
+</div>
+{% endfor %}
+
+<div class="instr">{{ en_range }}&nbsp;&nbsp;Choose O if the statement matches the passage, or X if it does not.</div>
+{% for it in group_b %}
+<div class="item en">
+  <span class="num-cell">{{ it.num }}</span>
+  <span class="text-cell">{{ it.text }}</span>
+  <span class="ox-cell">O&nbsp;&nbsp;X</span>
+</div>
+{% endfor %}
+
+<div class="key-page">
+  <div class="key-title">정답 (Answer Key)</div>
+  <div class="key-sub">{% if source %}{{ source }} · {% endif %}{{ title_ko }}</div>
+  <div class="key-grid">
+    {% for it in group_a + group_b %}
+    <span><b>{{ it.num }}</b>{{ it.answer }}</span>
+    {% endfor %}
+  </div>
+</div>
+
+</body>
+</html>
